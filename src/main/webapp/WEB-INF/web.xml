<?xml version="1.0" encoding="UTF-8"?>
<!-- Descriptor de despliegue de Grigora (Servlet 4.0 / Tomcat 9) -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Grigora - Instituto Técnico Central</display-name>

  <!-- Servlet de consulta: devuelve la ubicación de un salón (o el listado completo) -->
  <servlet>
    <servlet-name>ConsultaSalonServlet</servlet-name>
    <servlet-class>co.edu.etitc.grigora.servlet.ConsultaSalonServlet</servlet-class>
  </servlet>

  <!-- Ruta: http://localhost:8080/grigora/consulta?codigo=B204 -->
  <servlet-mapping>
    <servlet-name>ConsultaSalonServlet</servlet-name>
    <url-pattern>/consulta</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
